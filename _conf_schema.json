{
    "accounts": {
        "description": "账号列表（支持多种平台）",
        "type": "template_list",
        "hint": "点击添加按钮选择账号类型新增账号",
        "default": [],
        "disable_reset": true,
        "templates": {
            "xiaomi_account": {
                "name": "小米 MiMo 账号",
                "display_item": "name",
                "items": {
                    "platform": {
                        "description": "平台",
                        "type": "string",
                        "default": "mimo",
                        "invisible": true
                    },
                    "name": {
                        "description": "账号名称",
                        "type": "string",
                        "default": "",
                        "hint": "自定义显示名称，留空则显示账号"
                    },
                    "account": {
                        "description": "小米账号",
                        "type": "string",
                        "default": "",
                        "hint": "手机号或邮箱"
                    },
                    "password": {
                        "description": "小米密码",
                        "type": "string",
                        "default": ""
                    },
                    "device_id": {
                        "description": "设备标识",
                        "type": "string",
                        "default": "wb_MIQUERY000001",
                        "hint": "固定 deviceId 可避免反复触发 OTP\n默认: wb_MIQUERY000001"
                    },
                    "ua": {
                        "description": "User-Agent",
                        "type": "string",
                        "default": "APP/com.xiaomi.mihome APPV/11.3.203 iosPassportSDK/4.2.50 iOS/26.3.1",
                        "hint": "默认: APP/com.xiaomi.mihome APPV/11.3.203 iosPassportSDK/4.2.50 iOS/26.3.1"
                    },
                    "userId": {
                        "description": "用户 ID（自动填入）",
                        "type": "string",
                        "default": "",
                        "hint": "登录成功后自动保存，无需填写"
                    },
                    "passToken": {
                        "description": "通行令牌（自动填入）",
                        "type": "string",
                        "default": "",
                        "hint": "登录成功后自动保存，无需填写"
                    },
                    "serviceToken": {
                        "description": "serviceToken（自动填入）",
                        "type": "string",
                        "default": "",
                        "hint": "登录成功后自动保存，无需填写"
                    },
                    "template": {
                        "description": "消息模板（留空使用默认）",
                        "type": "text",
                        "default": "",
                        "hint": "可用变量: {label} {balance} {gift_balance} {input_token} {output_token} {cache_token} {monthly_cost} {total_cost}\n留空使用默认模板",
                        "invisible": true
                    }
                }
            },
            "wasu_account": {
                "name": "华数广电账号",
                "display_item": "name",
                "items": {
                    "platform": {
                        "description": "平台",
                        "type": "string",
                        "default": "wasu",
                        "invisible": true
                    },
                    "name": {
                        "description": "账号名称",
                        "type": "string",
                        "default": "",
                        "hint": "自定义显示名称，留空则显示手机号"
                    },
                    "user_key": {
                        "description": "User Key",
                        "type": "string",
                        "default": "",
                        "hint": "从华数广电小程序获取"
                    },
                    "token": {
                        "description": "Token",
                        "type": "string",
                        "default": "",
                        "hint": "从华数广电小程序获取"
                    },
                    "phone": {
                        "description": "手机号",
                        "type": "string",
                        "default": "",
                        "hint": "华数广电绑定的手机号"
                    },
                    "sign": {
                        "description": "签名",
                        "type": "string",
                        "default": "",
                        "hint": "从华数广电小程序获取（可选）"
                    },
                    "ua": {
                        "description": "User-Agent",
                        "type": "string",
                        "default": "Mozilla/5.0 (Linux; Android 16; 23127PN0CC Build/BP2A.250605.031.A3; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/150.0.7871.181 Mobile Safari/537.36",
                        "hint": "默认: Android Chrome UA"
                    },
                    "template": {
                        "description": "消息模板（留空使用默认）",
                        "type": "text",
                        "default": "",
                        "hint": "可用变量: {label} {balance} {month_fee} {arrears} {total_used} {total} {used} {remain} {query_time}\n留空使用默认模板",
                        "invisible": true
                    }
                }
            }
        }
    },

    "proxy": {
        "description": "网络代理",
        "type": "string",
        "default": "https://gh-proxy.cn/",
        "hint": "用于 GitHub 更新请求的代理地址，留空禁用代理"
    },
    "update_max_retries": {
        "description": "更新最大重试次数",
        "type": "int",
        "default": 3,
        "hint": "自动更新时网络请求失败的重试次数"
    }
}
