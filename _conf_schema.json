{
    "device_id": {
        "description": "默认设备标识",
        "type": "string",
        "default": "wb_MIQUERY000001",
        "hint": "MiMo 账号的默认设备标识，可在账号中单独覆盖"
    },
    "ua": {
        "description": "默认 User-Agent",
        "type": "string",
        "default": "APP/com.xiaomi.mihome APPV/11.3.203 iosPassportSDK/4.2.50 iOS/26.3.1",
        "hint": "MiMo 账号的默认 User-Agent，可在账号中单独覆盖"
    },
    "proxy": {
        "description": "网络代理",
        "type": "string",
        "default": "https://gh-proxy.cn/",
        "hint": "用于 GitHub 更新请求的代理地址，留空禁用代理"
    },
    "update_max_retries": {
        "description": "更新最大重试次数",
        "type": "int",
        "default": 3,
        "hint": "自动更新时网络请求失败的重试次数"
    }
}
